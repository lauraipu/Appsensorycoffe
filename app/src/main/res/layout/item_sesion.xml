<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_input_field"
    android:backgroundTint="@color/pure_white"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Fila de Etiquetas: Estado y Rol -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_estado_sesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="@color/gray_100"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:text="• En progreso"
            android:textColor="@color/slate_gray"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_formato_sesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="@color/gray_50"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:text="Combinado"
            android:textColor="@color/gray_500"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Nombre de la Sesión -->
    <TextView
        android:id="@+id/tv_nombre_sesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Nombre de la Sesión"
        android:textColor="@color/slate_gray"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Detalles: Código, Muestras, Catadores -->
    <TextView
        android:id="@+id/tv_detalle_sesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Código: CVA-001 | Muestras: 8"
        android:textColor="@color/gray_500"
        android:textSize="12sp" />

</LinearLayout>